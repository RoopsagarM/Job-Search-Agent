# This is the format Streamlit Community Cloud expects for secrets.
# You do NOT need this file locally (config.py handles that).
# On share.streamlit.io: go to your app > Settings > Secrets, and paste
# the contents below (with your real keys) into that box.

RAPIDAPI_KEY = "your_actual_key_here"

# Optional — enables the AI agent (Claude) for smarter parsing/scoring
# and resume tailoring
ANTHROPIC_API_KEY = "your_actual_anthropic_key_here"
